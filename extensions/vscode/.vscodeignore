# The VSIX ships the bundle, not the sources it was built from. The engine under
# ../../src is compiled into dist/extension.js by esbuild, so none of it is
# listed here — it is already inside the bundle.
src/**
node_modules/**
tsconfig.json
esbuild.mjs
**/*.map
.vscode/**
# The README points at the copies on raw.githubusercontent.com — the Marketplace
# renders from there, so shipping the screenshots in the VSIX buys nothing. A
# whole directory rather than each file, so a new screenshot cannot forget to
# opt out. media/icon.png is not in here: that one the VSIX genuinely needs.
media/screenshots/**

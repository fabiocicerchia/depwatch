{
  "name": "depwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency drift (libyears) + viability, plotted as a quadrant.",
  "license": "Apache-2.0",
  "author": "Fabio Cicerchia",
  "bin": {
    "depwatch": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' --tsconfig=tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
